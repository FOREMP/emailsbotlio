# A hostname with an A record pointing at this Lightsail instance.
SCRAPER_HOSTNAME=scraper.example.com
PUBLIC_BASE_URL=https://scraper.example.com

# Generate a unique value with: openssl rand -hex 32
# It must match the SCRAPER_WORKER_SECRET Supabase Edge Function secret.
SCRAPER_SHARED_SECRET=replace-with-a-long-random-secret

PORT=3000
MAX_HTTP_BYTES=1500000
MAX_BROWSER_CONCURRENCY=1
# Waiting is intentionally in memory only. It smooths brief overlapping audit
# and generation requests without launching extra Chromium processes or adding
# database/disk writes.
MAX_BROWSER_QUEUE=12
BROWSER_QUEUE_TIMEOUT_MS=30000
