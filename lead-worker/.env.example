# Reuse the existing scraper secret at first. Set LEAD_SOURCE_SHARED_SECRET in
# both Supabase and this file later to rotate lead sourcing independently.
SCRAPER_SHARED_SECRET=replace-with-the-existing-scraper-secret
SUPABASE_URL=https://your-project.supabase.co
LEAD_WORKER_DATA_DIR=/var/lib/botlio-leads
MAPS_API_URL=http://maps:8080
MAPS_SCRAPER_IMAGE=gosom/google-maps-scraper
# Depth-10 Google Maps jobs often need more than fifteen minutes because email
# enrichment happens inside the Maps scraper. Thirty minutes is the safe cap.
LEAD_JOB_TIMEOUT_SECONDS=1800
MAPS_REQUEST_TIMEOUT_SECONDS=25
LEAD_JOB_HEARTBEAT_SECONDS=30
MAX_QUEUED_LEAD_JOBS=10
